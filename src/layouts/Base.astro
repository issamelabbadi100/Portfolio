---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

const { t } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const paths = { fr: base, en: `${base}en/` };
const canonical = new URL(paths[t.lang], Astro.site).href;
const ogImage = new URL(`${base}og.png`, Astro.site).href;

// Phone intentionally left out of structured data.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: t.profile.name,
  jobTitle: t.profile.title,
  email: `mailto:${t.profile.email}`,
  url: canonical,
  address: { '@type': 'PostalAddress', addressLocality: 'Fès', addressCountry: 'MA' },
  sameAs: [t.profile.linkedin, t.profile.github],
  knowsLanguage: ['ar', 'fr', 'en'],
};
---
<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={new URL(paths.fr, Astro.site).href} />
    <link rel="alternate" hreflang="en" href={new URL(paths.en, Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(paths.fr, Astro.site).href} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#0a1020" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={t.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Runs before paint: apply saved theme, and send returning English readers to /en/. -->
    <script is:inline define:vars={{ enPath: paths.en, isFr: t.lang === 'fr' }}>
      var d = document.documentElement;
      d.classList.add('js');
      try {
        var th = localStorage.getItem('theme');
        if (th) d.dataset.theme = th;
        if (isFr && localStorage.getItem('lang') === 'en') location.replace(enPath);
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
    <script is:inline>
      document.addEventListener('click', function (e) {
        var lang = e.target.closest('[data-lang]');
        if (lang) { try { localStorage.setItem('lang', lang.dataset.lang); } catch (err) {} }
        if (e.target.closest('[data-theme-toggle]')) {
          var d = document.documentElement;
          var dark = d.dataset.theme ? d.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
          d.dataset.theme = dark ? 'light' : 'dark';
          try { localStorage.setItem('theme', d.dataset.theme); } catch (err) {}
        }
      });
      var items = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) { en.target.classList.add('is-visible'); io.unobserve(en.target); }
          });
        }, { rootMargin: '0px 0px -10% 0px' });
        items.forEach(function (el) { io.observe(el); });
        // Highlight the nav link of the section crossing the middle of the viewport.
        var spy = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (!en.isIntersecting) return;
            document.querySelectorAll('[data-spy]').forEach(function (a) {
              if (a.dataset.spy === en.target.dataset.nav) a.setAttribute('aria-current', 'true');
              else a.removeAttribute('aria-current');
            });
          });
        }, { rootMargin: '-45% 0px -50% 0px' });
        document.querySelectorAll('[data-nav]').forEach(function (s) { spy.observe(s); });
      } else {
        items.forEach(function (el) { el.classList.add('is-visible'); });
      }
    </script>
  </body>
</html>
