---
const { t } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const other = t.lang === 'fr' ? { lang: 'en', href: `${base}en/` } : { lang: 'fr', href: base };
const links = ['about', 'skills', 'experience', 'projects', 'education', 'contact'];
---
<a class="skip-link" href="#main">{t.nav.skip}</a>
<header class="site-header">
  <div class="wrap bar">
    <a class="brand mono" href="#top">
      <span class="prompt" aria-hidden="true">~/</span>{t.profile.name}
    </a>
    <nav aria-label={t.nav.label}>
      <ul>
        {links.map((id) => <li><a href={`#${id}`} data-spy={id}>{t.nav[id]}</a></li>)}
      </ul>
    </nav>
    <div class="tools">
      <div class="lang mono" role="group" aria-label={t.nav.langLabel}>
        {['fr', 'en'].map((l) => l === t.lang
          ? <span class="lang-opt current" aria-current="true">{l.toUpperCase()}</span>
          : <a class="lang-opt" href={other.href} hreflang={l} lang={l} data-lang={l}
               aria-label={t.nav.langSwitchLabel}>{l.toUpperCase()}</a>)}
      </div>
      <button class="tool" type="button" data-theme-toggle aria-label={t.nav.themeToggle}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" />
          <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" />
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  /* Phone: brand + tools on row one, scrollable section links on row two. */
  .bar {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: 3.5rem auto;
    grid-template-areas: 'brand tools' 'nav nav';
    align-items: center;
    column-gap: 0.75rem;
  }
  .brand {
    grid-area: brand;
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  .prompt { color: var(--accent); }
  @media (max-width: 23rem) {
    .prompt { display: none; }
  }
  nav {
    grid-area: nav;
    overflow-x: auto;
    scrollbar-width: none;
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
    border-top: 1px solid var(--border);
  }
  nav::-webkit-scrollbar { display: none; }
  nav ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    white-space: nowrap;
  }
  nav a {
    display: block;
    padding-block: 0.65rem;
    border-bottom: 2px solid transparent;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    text-decoration: none;
  }
  nav a:hover { color: var(--text); }
  nav a[aria-current='true'] {
    color: var(--text);
    border-bottom-color: var(--accent);
  }
  .tools { grid-area: tools; display: flex; gap: 0.5rem; }
  .tool {
    display: inline-grid;
    place-items: center;
    min-width: 2.75rem;
    height: 2.75rem;
    padding: 0 0.6rem;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }
  .tool:hover { border-color: var(--accent); }
  /* Language switch: current language filled, the other one is the link. */
  .lang {
    display: flex;
    height: 2.75rem;
    padding: 3px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 0.8rem;
    font-weight: 600;
  }
  .lang-opt {
    display: grid;
    place-items: center;
    min-width: 2.4rem;
    border-radius: 4px;
    color: var(--muted);
    text-decoration: none;
  }
  a.lang-opt:hover { color: var(--text); background: var(--surface); }
  .lang-opt.current { background: var(--accent); color: var(--accent-ink); }
  @media (min-width: 60rem) {
    .bar {
      grid-template-columns: auto 1fr auto;
      grid-template-rows: 3.5rem;
      grid-template-areas: 'brand nav tools';
    }
    nav {
      justify-self: end;
      margin: 0;
      padding: 0;
      border-top: 0;
    }
    nav a { padding-block: 1.1rem; }
  }
</style>
