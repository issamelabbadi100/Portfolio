---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import About from './About.astro';

const { t } = Astro.props;
---
<Base t={t}>
  <Header t={t} />
  <main id="main" tabindex="-1">
    <div id="top"></div>
    <Hero t={t} />
    <About t={t} />
  </main>
</Base>
