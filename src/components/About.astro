---
const { t } = Astro.props;
---
<section id="about" class="section" aria-labelledby="about-title">
  <div class="wrap reveal">
    <h2 id="about-title" class="section-title"><span class="idx" aria-hidden="true">01</span>{t.about.title}</h2>
    <div class="prose">
      {t.about.paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </div>
</section>
