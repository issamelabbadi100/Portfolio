---
const { t } = Astro.props;
---
<section id="experience" data-nav="experience" class="section" aria-labelledby="experience-title">
  <div class="wrap">
    <h2 id="experience-title" class="section-title reveal"><span class="idx" aria-hidden="true">03</span>{t.experience.title}</h2>
    <ol class="timeline">
      {t.experience.employers.map((e) => (
        <li class="employer reveal">
          <p class="company mono">
            <strong>{e.company}</strong>
            <span class="muted">{e.location} · {e.dates}</span>
          </p>
          <ol class="roles">
            {e.roles.map((r) => (
              <li class="role">
                <h3>{r.role}</h3>
                <p class="dates mono muted">{r.dates}</p>
                <ul class="prose">{r.bullets.map((b) => <li>{b}</li>)}</ul>
              </li>
            ))}
          </ol>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  ol { list-style: none; margin: 0; padding: 0; }
  .employer + .employer { margin-top: 2.5rem; }
  .company {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin-bottom: 1rem;
    font-size: 1.05rem;
  }
  .company .muted { font-size: 0.85rem; }
  /* Vertical rail with a node per role. */
  .roles {
    position: relative;
    padding-left: 1.5rem;
    border-left: 2px solid var(--border);
  }
  .role { position: relative; }
  .role + .role { margin-top: 1.75rem; }
  .role::before {
    content: '';
    position: absolute;
    left: calc(-1.5rem - 6px);
    top: 0.4rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }
  .role:first-child::before { background: var(--accent); }
  h3 { margin-bottom: 0.15rem; }
  .dates { font-size: 0.82rem; margin-bottom: 0.6rem; }
  .role ul { margin: 0; padding-left: 1.1rem; }
  .role ul li { margin-bottom: 0.35rem; }
  .role ul li::marker { color: var(--accent); }
</style>
