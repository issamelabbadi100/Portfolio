---
// d.steps: [label, sub, badge?], or [[label, sub], [label, sub]] for two parallel sources. `key` keeps SVG ids unique when several diagrams share a page.
const { d, key } = Astro.props;
const step = 84, boxH = 56, x = 16, w = 288;
const height = 8 + (d.steps.length - 1) * step + boxH + 8;
---
<figure class="diagram">
  <svg viewBox={`0 0 320 ${height}`} role="img" aria-labelledby={`${key}-title ${key}-desc`}>
    <title id={`${key}-title`}>{d.title}</title>
    <desc id={`${key}-desc`}>{d.desc}</desc>
    <defs>
      <marker id={`${key}-arrow`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0 10 5 0 10z" class="arrow-head" />
      </marker>
    </defs>
    {d.steps.map((s, i) => {
      const y = 8 + i * step;
      if (Array.isArray(s[0])) {
        const hw = (w - 16) / 2;
        return (
          <g>
            {s.map(([label, sub], j) => {
              const bx = x + j * (hw + 16);
              return (
                <g>
                  <rect x={bx} y={y} width={hw} height={boxH} rx="6" class="box" />
                  <text x={bx + 14} y={y + 24} class="label">{label}</text>
                  <text x={bx + 14} y={y + 43} class="sub">{sub}</text>
                  <line x1={bx + hw / 2} y1={y + boxH} x2={160 + (j ? 14 : -14)} y2={y + step - 3} class="arrow" marker-end={`url(#${key}-arrow)`} />
                </g>
              );
            })}
          </g>
        );
      }
      const [label, sub, badge] = s;
      const num = d.steps.slice(0, i + 1).filter((t) => !Array.isArray(t[0])).length;
      const parallelAbove = i > 0 && Array.isArray(d.steps[i - 1][0]);
      const bw = 14 + badge?.length * 7;
      return (
        <g>
          {i > 0 && !parallelAbove && <line x1="160" y1={y - step + boxH} x2="160" y2={y - 3} class="arrow" marker-end={`url(#${key}-arrow)`} />}
          <rect x={x} y={y} width={w} height={boxH} rx="6" class="box" />
          <text x={x + 16} y={y + 33} class="num">{String(num).padStart(2, '0')}</text>
          <text x={x + 48} y={y + 24} class="label">{label}</text>
          <text x={x + 48} y={y + 43} class="sub">{sub}</text>
          {badge && (
            <g>
              <rect x={x + w - 12 - bw} y={y + 17} width={bw} height="22" rx="4" class="badge" />
              <text x={x + w - 12 - bw / 2} y={y + 32} class="badge-text" text-anchor="middle">{badge}</text>
            </g>
          )}
        </g>
      );
    })}
  </svg>
  <figcaption class="muted">{d.legend}</figcaption>
</figure>

<style>
  .diagram { margin: 0; max-width: 22rem; }
  svg { display: block; width: 100%; height: auto; }
  .box { fill: var(--bg); stroke: var(--border); stroke-width: 1.5; }
  .num { fill: var(--accent); font: 600 12px var(--font-mono); }
  .label { fill: var(--text); font: 600 15px var(--font-sans); }
  .sub { fill: var(--muted); font: 400 12px var(--font-mono); }
  .arrow { stroke: var(--muted); stroke-width: 1.5; }
  .arrow-head { fill: var(--muted); }
  .badge { fill: none; stroke: var(--accent); stroke-width: 1.5; }
  .badge-text { fill: var(--accent); font: 700 11px var(--font-mono); }
  figcaption { margin-top: 0.75rem; font-size: 0.85rem; line-height: 1.5; }
</style>
